# Radar Promo - Environment Variables
# Salin file ini ke .env dan isi nilainya
# Ganti dengan nilai Anda sendiri. Jangan commit kunci nyata.

# Google Apps Script URL untuk sync ke Google Sheets
RADAR_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# ImgBB API Key untuk upload foto
RADAR_IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# Admin login credentials
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=change_me
